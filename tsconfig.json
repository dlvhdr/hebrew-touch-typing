{
  "compilerOptions": {
    "target": "es2015",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "jest", "@testing-library/jest-dom"],
    "allowJs": false,
    "jsx": "react",
    "outDir": "./dist",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "./jest-setup.ts", "__mocks__/*"],
  "exclude": ["node_modules", "dist", "public"]
}
